generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  fullName  String    @default("Unknown Practitioner")
  email     String    @unique
  password  String
  role      String    @default("practitioner")
  authLogs  AuthLog[]
  createdAt DateTime  @default(now())
}

model AuthLog {
  id        String   @id @default(uuid())
  status    String
  ip        String?
  userEmail String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Patient {
  id         String   @id @default(uuid())
  fullName   String
  email      String   @unique
  age        Int
  gender     String
  bloodGroup String
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  healthReadings HealthReading[]
}

model HealthReading {
  id          String   @id @default(uuid())
  patientId   String
  weightKg    Float
  heightCm    Float
  bmi         Float
  heartRate   Float
  temperature Float
  spo2        Float
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}